# Copy to .env and edit (never commit the copy). Every value has a safe default; nothing here is required.
# Placeholders only. Tokens are created on first connect and kept in data/ (git-ignored, owner-only files).

# --- Server (local only: the API can move a robot, do not bind to 0.0.0.0) ---
LOCKEDIN_HOST=127.0.0.1
LOCKEDIN_PORT=8077
LOCKEDIN_LOG_LEVEL=INFO

# --- Legacy LOCKED IN robot (unused by AIRLOCK; keep mock) ---
# mock = simulator (auto-connects, labelled SIMULATED); zeus = SunFounder Zeus Car
LOCKEDIN_ROBOT_DRIVER=mock
LOCKEDIN_ZEUS_HOST=192.168.4.1
LOCKEDIN_ZEUS_PORT=8765
# Leave false until hardware test R5 (docs/legacy/SAFETY.md) has measured the robot stopping on
# its own when the laptop link goes silent. While false, autonomous motion on the real
# robot is refused.
LOCKEDIN_ZEUS_DEVICE_WATCHDOG_VERIFIED=false
LOCKEDIN_ZEUS_DEVICE_WATCHDOG_TIMEOUT_S=4.0
# Real-robot motor commands (docs/legacy/SAFETY.md section 7). disabled = monitor link: no motion and
# no Stop frame is ever sent (Milestone 3 ships this way). bench = wheels-off-ground tests, only
# with the LOCKED IN firmware patch reported by the robot. enabled = bench + R5 verified.
LOCKEDIN_ZEUS_MOTOR_COMMANDS=disabled
# make hardware sets these for you:
LOCKEDIN_ZEUS_AUTOCONNECT=false
# ESP32-CAM stream; empty = http://<zeus host>:9000/mjpg
LOCKEDIN_ZEUS_CAMERA_URL=

# --- Vision ---
LOCKEDIN_VISION_AUTOSTART=false
LOCKEDIN_CAMERA_WIDTH=640
LOCKEDIN_CAMERA_HEIGHT=480
# Startup camera, overriding the dashboard's choice: zeus, 0 (Mac webcam), a URL or a file
LOCKEDIN_CAMERA_SOURCE=
# MJPEG streams: http (LOCKED IN's reader, default) or opencv (FFmpeg); both decode with OpenCV
LOCKEDIN_MJPEG_BACKEND=http
# Offline (robot Wi-Fi): Fish Audio, the LLM and model hubs are never contacted
LOCKEDIN_OFFLINE=false
# Raw video is never stored unless this is true (nothing currently writes video).
LOCKEDIN_STORE_RAW_VIDEO=false

# --- Voice ---
# parakeet+whisper (default): NVIDIA Parakeet (NeMo-Speech.cpp) and whisper.cpp on the same audio,
# combined; whisper.cpp alone if the NVIDIA files are missing. whisper.cpp | faster-whisper | none
LOCKEDIN_STT_ENGINE=parakeet+whisper
LOCKEDIN_WHISPER_MODEL=base.en
LOCKEDIN_VOICE_AUTOSTART=false
# system = speak (the dashboard's voice profile picks local voice / Fish Audio); none = silent
LOCKEDIN_TTS_ENGINE=system
LOCKEDIN_TTS_VOICE=
LOCKEDIN_TTS_RATE_WPM=190

# --- Conversation ---
# local = Qwen3 on this Mac (MLX, offline; weights from `make models`); none = fixed lines only;
# anthropic = optional Claude replies (paid API, internet, ANTHROPIC_API_KEY below; text only)
LOCKEDIN_LLM_PROVIDER=local
LOCKEDIN_LOCAL_LLM_MODEL=Qwen3-4B-Instruct-2507-4bit

# --- Paid services: off unless you fill these in ---
# Fish Audio (https://fish.audio/app/api-keys/). Backend only: never sent to the dashboard or
# logged. Voice, model and the approval for live / cached generation are set in the dashboard
# (Personality + Voice). Without a key LOCKED IN speaks with the local voice.
FISH_AUDIO_API_KEY=
# Only for LOCKEDIN_LLM_PROVIDER=anthropic (never controls the robot; replies citing numbers
# not in the session are discarded)
ANTHROPIC_API_KEY=
LOCKEDIN_LLM_MODEL=claude-opus-5-5

# --- LOCKI AIRLOCK (make airlock-mac sets LOCKEDIN_SECURITY_ENABLED and LOCKEDIN_OFFLINE for you) ---
LOCKEDIN_SECURITY_ENABLED=false
LOCKEDIN_SECURITY_LOCK_MODE=dry_run            # dry_run | real. Real locks only after the owner agrees to test one, with someone there to unlock
LOCKEDIN_SECURITY_LOCK_MECHANISM=keystroke     # keystroke (needs Accessibility permission) | login_framework
LOCKEDIN_SECURITY_USB_WATCHER=iokit            # iokit | poll
LOCKEDIN_SECURITY_APP_WATCHER=nsworkspace      # nsworkspace | snapshot
LOCKEDIN_SECURITY_KEEP_PERSONALITY=false       # with security on, LOCKI speaks plainly unless this is true
LOCKEDIN_SECURITY_VOICE=am_onyx                # one local Kokoro voice for every security line; delivery changes with the mode

# The team's SpacetimeDB module (public endpoint names, not credentials). Unset = local only
LOCKEDIN_SPACETIME_URL=                        # e.g. https://maincloud.spacetimedb.com
LOCKEDIN_SPACETIME_DATABASE=                   # e.g. locki-w91bw
LOCKEDIN_SPACETIME_WORKSTATION=                # the workstation id the owner registered

# Desk camera on the Mac: on only while armed or in a demo
LOCKEDIN_AIRLOCK_VISION=false
LOCKEDIN_AIRLOCK_VISION_SOURCE=0               # camera index, MJPEG URL or file
LOCKEDIN_AIRLOCK_VISION_LABEL=mac_webcam

# Nemotron investigator through Ollama. For the M5, open an SSH tunnel and point here (no fixed address in config):
#   ssh -N -L 11435:127.0.0.1:11434 <user>@<m5-tailscale-name>
LOCKEDIN_AIRLOCK_MODEL=nemotron-3.5-bolt:e4b
LOCKEDIN_AIRLOCK_OLLAMA_URL=http://127.0.0.1:11434   # http://127.0.0.1:11435 through the tunnel
LOCKEDIN_AIRLOCK_FALLBACK_MODEL=true
