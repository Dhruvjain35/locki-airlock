# LOCKI AIRLOCK edge runtime config. Copy to ~/.config/locki-edge/airlock.env and chmod 600.
# Placeholders only: never commit a real token or a filled-in copy of this file.
#   cd edge/jetson && python3 -m locki_edge.runtime --env-file ~/.config/locki-edge/airlock.env

# mac_dev = Areeb's Mac webcam (dev/integration only). jetson = the real Jetson. The runtime refuses
# "jetson" on a machine without /etc/nv_tegra_release, so Mac frames can't be labeled Jetson evidence.
AIRLOCK_EDGE_RUNTIME=mac_dev

# Mac: 0 (built-in) or 1 (USB Logitech). Jetson: the stable path from `ls /dev/v4l/by-id/`.
AIRLOCK_CAMERA_SOURCE=0
AIRLOCK_WIDTH=640
AIRLOCK_HEIGHT=480

# Identity: each physical capture device gets its OWN enrolled id + token.
# Mac dev camera -> mac-dev-cam-01; Jetson -> jetson-01 (token minted ON the Jetson).
AIRLOCK_DEVICE_ID=mac-dev-cam-01
AIRLOCK_WORKSTATION_ID=dhruv-m4-air
# auto = follow the workstation's live armed session (read from my_workstations/my_sessions as this device).
# The module rejects camera events outside it ("No matching live armed session"); while disarmed the edge
# keeps events in the local audit only. Any other value is sent verbatim.
AIRLOCK_SESSION_ID=auto
AIRLOCK_DATABASE=locki-w91bw
AIRLOCK_SERVER=maincloud
# Token from: python3 tools/stdb_live.py mint --out ~/.config/locki-edge/device_token  (chmod 600)
AIRLOCK_EDGE_AUTH_FILE=~/.config/locki-edge/device_token
# Owner/admin identities this device must NEVER publish as (comma-separated hex, 0x prefix optional).
# The operator fills in the workstation owner's identity (my_workstations.owner) in the device's own copy;
# the runtime then refuses to start on that token. The template carries a placeholder, never a live identity.
AIRLOCK_FORBIDDEN_IDENTITIES=0x<owner-identity-hex>
# auto = publish when id + workstation + token exist; off = local audit log only; on = fail if missing.
AIRLOCK_PUBLISH=auto

# Desk zones, normalized x1,y1,x2,y2. Either inline (id:rect;id:rect) or a JSON file {"zones":[...]}.
AIRLOCK_ZONES=desk_01:0.25,0.35,0.75,1.0
AIRLOCK_ZONE_CONFIG=

# baseline = motion-in-zone (motion_in_zone is NOT permitted for role "jetson": local audit only).
# detectnet = Jetson TensorRT person boxes. apple_vision = Mac dev person baseline (mac_dev only).
# opencv_dnn = MobileNet-SSD person boxes on OpenCV DNN, CPU (JetPack 6, where detectNet's models do not load).
#   It needs the Caffe prototxt + caffemodel at AIRLOCK_DNN_PROTOTXT / AIRLOCK_DNN_MODEL (weights are never committed).
# dhruv_cv = Dhruv's provider via AIRLOCK_OBSERVER_PLUGIN. fixture = scripted, always simulated=true.
AIRLOCK_OBSERVER=baseline
# Live-learned module rules for role "jetson" (kinds, metadata, health vocabulary):
AIRLOCK_CONTRACT_FILE=contract/locki-w91bw.live.json
AIRLOCK_OBSERVER_PLUGIN=
AIRLOCK_OBSERVER_PATH=
AIRLOCK_OBSERVER_KIND_MAP=
AIRLOCK_DNN_PROTOTXT=~/models/MobileNetSSD_deploy.prototxt
AIRLOCK_DNN_MODEL=~/models/MobileNetSSD_deploy.caffemodel

# Debounce: frames to confirm entry, seconds to confirm exit, cooldown between motion events.
AIRLOCK_ENTER_FRAMES=3
# Presence hold, measured on the Mac (Apple Vision, 45 min, 2026-11-08): a 2 s exit gave 63 enters; the absence
# gaps between them were p50 7.8 s, 34/62 < 8 s, 47/62 < 15 s. 15 s suppresses 47 of those re-enters (8 s: 34).
# Cost: after arming, the zone must stay empty this long before a walk-in publishes. person_left_zone is local-only.
# AIRLOCK_COOLDOWN_S never applies to presence: it spaces motion and face/hand events only.
AIRLOCK_EXIT_S=15
AIRLOCK_COOLDOWN_S=30
AIRLOCK_UNAVAILABLE_AFTER_S=2.0
# Exit with code 3 (systemd restarts us) if a driver read hangs this long. 0 = off. Jetson: 60.
AIRLOCK_RESTART_ON_STALL_S=0

# Local API stays on loopback. From another machine use a tunnel, never a public bind:
#   ssh -N -L 8765:127.0.0.1:8765 <user>@<jetson>   then   curl localhost:8765/health
AIRLOCK_API_HOST=127.0.0.1
AIRLOCK_API_PORT=8765
AIRLOCK_API_TOKEN=

AIRLOCK_STATE_DIR=~/.local/state/locki-edge
AIRLOCK_HEALTH_INTERVAL_S=5
AIRLOCK_MAX_PENDING=1000
AIRLOCK_MAX_EVENT_AGE_S=900

# Physical alarm: off until a speaker is confirmed on this device (aplay -l on Jetson).
AIRLOCK_LOCAL_ALARM=off
AIRLOCK_ALARM_DEVICE=
# WAV to play. Empty = edge/jetson/assets/alert.wav, which this repo does not ship (audio files are ignored), so point
# this at a local file before turning the alarm on.
AIRLOCK_ALARM_WAV=
